{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <main class="page-shell">
        <div class="home-layout">
            {% include 'home/_stats_sidebar.html.twig' with { sidebar_stats: sidebar_stats, filters: filters } only %}

            <div class="home-main">
                <header class="hero">
                    <a href="{{ path('app_home') }}" class="hero-brand" aria-label="Retour a l'accueil">
                        <img src="{{ asset(logo_asset) }}" alt="{{ title }}" class="hero-logo">
                        <h1>{{ title }}</h1>
                    </a>
                    <p class="lead">
                        {{ subtitle }}
                    </p>
                    {% include 'home/_view_nav.html.twig' with { active_view: 'table', filters: filters } only %}
                </header>

                <section class="panel">
                    <div class="panel-head">
                        <h2>Données CSV</h2>
                        <div class="panel-meta">
                            <code>{{ csv_path }}</code>
                            <span class="pill">{{ stats.filtered }} / {{ stats.total }}</span>
                            <span class="pill pill-soft">vivants: {{ stats.alive }}</span>
                            <span class="pill pill-soft">décédés: {{ stats.dead }}</span>
                        </div>
                    </div>

                    {% include 'home/_filters.html.twig' with {
                        form_route: 'app_home',
                        filters: filters,
                        year_options: year_options,
                        theme_options: theme_options
                    } only %}

                    {% if animals is empty %}
                        <p class="empty">
                            Aucun résultat pour ces filtres.
                        </p>
                    {% else %}
                        {% include 'home/_animal_table.html.twig' with { animals: animals } only %}
                    {% endif %}
                </section>
            </div>
        </div>
    </main>
{% endblock %}
